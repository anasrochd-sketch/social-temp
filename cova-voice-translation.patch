diff --git a/docs/COMMUNITY_GROUPS_UPDATE.md b/docs/COMMUNITY_GROUPS_UPDATE.md
index 2e527e5..dbbc952 100644
--- a/docs/COMMUNITY_GROUPS_UPDATE.md
+++ b/docs/COMMUNITY_GROUPS_UPDATE.md
@@ -63,3 +63,23 @@ inside a voice room — and invite links do the joining automatically:
 Changed files: `GroupDetail.tsx` (+auto-join), `CommunityDetail.tsx` (+SharePanel, +auto-join),
 `VoiceRoom.tsx` (+SharePanel), and the two page files that forward `?join=`.
 No new migration is needed — it reuses the existing `join_codes` tables and RPCs.
+
+## Round 3: live voice translation (captions)
+
+Every voice room now has a "Live translation" panel. When a participant turns on
+transcription, their browser converts speech to text (Web Speech API) and the room
+relays each sentence; every other participant reads it translated into the interface
+language they picked (en / fr / ar).
+
+- Server: new `caption` action in `src/server/spaces-store.ts` (members only, voice
+  rooms only, last 30 lines kept in memory, no database change).
+- Translation: new `POST /api/translate` (`src/app/api/translate/route.ts`) with a
+  three-provider fallback chain, 5 s timeout, in-memory cache and a 60 req/min
+  per-IP limit. No API key, nothing to configure.
+- Client: `src/components/voicing/VoiceCaptions.tsx` (transcription toggle, live
+  list, automatic direction handling for Arabic), wired into `VoiceRoom.tsx`.
+- Browser support: transcription needs Chrome / Edge (Web Speech API); other
+  browsers still see everyone else's captions, just without sending their own.
+
+Also: removed the duplicated share box that round 2 added next to the voice-room
+panel — the panel itself already had one.
diff --git a/src/app/api/translate/route.ts b/src/app/api/translate/route.ts
new file mode 100644
index 0000000..1bccd3e
--- /dev/null
+++ b/src/app/api/translate/route.ts
@@ -0,0 +1,149 @@
+/**
+ * Lightweight machine translation for live voice captions.
+ *
+ * Tries a chain of free, key-less public endpoints from the server (the browser
+ * never talks to them directly, so CORS is not an issue):
+ *   1. translate.googleapis.com  (classic gtx endpoint)
+ *   2. clients5.google.com       (dict-chrome-ex client, usually reachable)
+ *   3. api.mymemory.translated.net
+ * Every result is cached in memory and a small per-IP rate limit protects the
+ * route. If every upstream fails the client falls back to the original text —
+ * the feature degrades, it never breaks.
+ */
+
+export const runtime = "nodejs";
+
+const TARGETS = new Set(["en", "fr", "ar"]);
+const TEXT_MAX = 500;
+const CACHE_MAX = 500;
+const RATE_MAX = 60; // requests per window per IP
+const RATE_WINDOW_MS = 60_000;
+const UPSTREAM_TIMEOUT_MS = 5000;
+
+const cache = new Map<string, string>();
+const rate = new Map<string, { n: number; resetAt: number }>();
+
+function limited(ip: string): boolean {
+  const now = Date.now();
+  let entry = rate.get(ip);
+  if (!entry || entry.resetAt < now) {
+    entry = { n: 0, resetAt: now + RATE_WINDOW_MS };
+    rate.set(ip, entry);
+  }
+  entry.n += 1;
+  return entry.n > RATE_MAX;
+}
+
+function remember(key: string, value: string) {
+  if (cache.size >= CACHE_MAX) {
+    const oldest = cache.keys().next().value;
+    if (oldest !== undefined) cache.delete(oldest);
+  }
+  cache.set(key, value);
+}
+
+async function getJson(url: string): Promise<unknown> {
+  const res = await fetch(url, {
+    signal: AbortSignal.timeout(UPSTREAM_TIMEOUT_MS),
+    headers: { "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" },
+  });
+  if (!res.ok) throw new Error(`upstream_${res.status}`);
+  return res.json();
+}
+
+/** translate.googleapis.com/translate_a/single → [[["Hola","hello",...],...],...] */
+function parseGtx(data: unknown): string {
+  if (!Array.isArray(data) || !Array.isArray(data[0])) return "";
+  return (data[0] as unknown[])
+    .map((chunk) => (Array.isArray(chunk) ? String(chunk[0] ?? "") : ""))
+    .join("")
+    .trim();
+}
+
+/** clients5.google.com/translate_a/t → [["Hola","en"],...] or ["Hola",...] */
+function parseClients5(data: unknown): string {
+  if (!Array.isArray(data)) return "";
+  if (Array.isArray(data[0])) {
+    return (data as unknown[])
+      .map((item) => (Array.isArray(item) ? String(item[0] ?? "") : ""))
+      .join("")
+      .trim();
+  }
+  return (data as unknown[]).map((item) => String(item ?? "")).join("").trim();
+}
+
+/** api.mymemory.translated.net → { responseData: { translatedText } } */
+function parseMyMemory(data: unknown): string {
+  const text = (data as { responseData?: { translatedText?: unknown } })?.responseData
+    ?.translatedText;
+  if (typeof text !== "string") return "";
+  if (/MYMEMORY WARNING/i.test(text)) return ""; // quota exhausted
+  return text.trim();
+}
+
+async function translateUpstream(text: string, to: string, from: string): Promise<string> {
+  const q = encodeURIComponent(text);
+
+  // 1. Classic gtx endpoint.
+  const gtx = parseGtx(
+    await getJson(
+      `https://translate.googleapis.com/translate_a/single?client=gtx&dt=t&sl=${from}&tl=${to}&q=${q}`,
+    ),
+  );
+  if (gtx) return gtx;
+
+  // 2. Chrome dictionary client (different frontend, often reachable from servers).
+  const c5 = parseClients5(
+    await getJson(
+      `https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=${from}&tl=${to}&q=${q}`,
+    ),
+  );
+  if (c5) return c5;
+
+  // 3. MyMemory (needs an explicit source language).
+  const src = from && from !== "auto" ? from : "en";
+  const mm = parseMyMemory(
+    await getJson(`https://api.mymemory.translated.net/get?q=${q}&langpair=${src}|${to}`),
+  );
+  if (mm) return mm;
+
+  throw new Error("all_providers_failed");
+}
+
+export async function POST(req: Request) {
+  const ip =
+    req.headers.get("x-forwarded-for")?.split(",")[0]?.trim() ||
+    req.headers.get("x-real-ip") ||
+    "local";
+  if (limited(ip)) {
+    return Response.json({ ok: false, error: "rate_limited" }, { status: 429 });
+  }
+
+  let body: { text?: unknown; to?: unknown; from?: unknown };
+  try {
+    body = (await req.json()) as typeof body;
+  } catch {
+    return Response.json({ ok: false, error: "bad_request" }, { status: 400 });
+  }
+
+  const text = typeof body.text === "string" ? body.text.trim().slice(0, TEXT_MAX) : "";
+  const to = typeof body.to === "string" ? body.to.slice(0, 8) : "";
+  const from = typeof body.from === "string" ? body.from.slice(0, 8) : "auto";
+  if (!text || !TARGETS.has(to)) {
+    return Response.json({ ok: false, error: "bad_request" }, { status: 400 });
+  }
+
+  const key = `${from}|${to}|${text}`;
+  const hit = cache.get(key);
+  if (hit !== undefined) return Response.json({ ok: true, translated: hit });
+
+  try {
+    const translated = await translateUpstream(text, to, from);
+    if (!translated) throw new Error("empty");
+    remember(key, translated);
+    return Response.json({ ok: true, translated });
+  } catch (err) {
+    console.error("translate failed:", err instanceof Error ? err.message : err);
+    return Response.json({ ok: false, error: "translate_failed" }, { status: 502 });
+  }
+}
diff --git a/src/components/voicing/VoiceCaptions.tsx b/src/components/voicing/VoiceCaptions.tsx
new file mode 100644
index 0000000..e070372
--- /dev/null
+++ b/src/components/voicing/VoiceCaptions.tsx
@@ -0,0 +1,268 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { Languages, Mic, MicOff } from "lucide-react";
+import { Button } from "@/components/ui/Button";
+import { Card, CardBody } from "@/components/ui/Card";
+import { useI18n } from "@/i18n/client";
+import { useS } from "@/i18n/spaces";
+import { LOCALE_DIR, type Locale } from "@/i18n/config";
+import type { Caption } from "@/server/spaces-store";
+
+type Send = (body: Record<string, unknown>) => Promise<unknown>;
+
+/* Minimal typings for the Web Speech API (not in every TS lib target). */
+interface SpeechAlternative {
+  transcript: string;
+}
+interface SpeechResult {
+  isFinal: boolean;
+  length: number;
+  [index: number]: SpeechAlternative;
+}
+interface SpeechResultList {
+  length: number;
+  [index: number]: SpeechResult;
+}
+interface SpeechEvent {
+  resultIndex: number;
+  results: SpeechResultList;
+}
+interface SpeechRecognitionLike {
+  lang: string;
+  continuous: boolean;
+  interimResults: boolean;
+  start(): void;
+  stop(): void;
+  abort(): void;
+  onresult: ((e: SpeechEvent) => void) | null;
+  onend: (() => void) | null;
+  onerror: ((e: { error: string }) => void) | null;
+}
+
+/** UI locale -> speech recognition language. */
+const SPEECH_LANG: Record<Locale, string> = {
+  en: "en-US",
+  fr: "fr-FR",
+  ar: "ar-SA",
+};
+
+const shortLang = (lang: string) => (lang.split("-")[0] || "?").toUpperCase();
+const isRtlLang = (lang: string) => lang.toLowerCase().startsWith("ar");
+
+/**
+ * Live captions for voice rooms: your speech is transcribed by the browser,
+ * relayed through the room, and every participant reads each line translated
+ * into the interface language they picked. Best in Chrome / Edge.
+ */
+export function VoiceCaptions({
+  captions,
+  meUid,
+  send,
+}: {
+  captions: Caption[];
+  meUid: string;
+  send: Send;
+}) {
+  const t = useS();
+  const { locale } = useI18n();
+
+  const [listening, setListening] = useState(false);
+  const [notice, setNotice] = useState("");
+  const [translated, setTranslated] = useState<Record<string, string>>({});
+
+  const recRef = useRef<SpeechRecognitionLike | null>(null);
+  const wantRef = useRef(false);
+  const lastSentRef = useRef({ text: "", at: 0 });
+  const requestedRef = useRef(new Set<string>());
+  const listRef = useRef<HTMLDivElement | null>(null);
+
+  const supported =
+    typeof window !== "undefined" &&
+    !!((window as unknown as { SpeechRecognition?: unknown }).SpeechRecognition ??
+      (window as unknown as { webkitSpeechRecognition?: unknown }).webkitSpeechRecognition);
+
+  const pushCaption = useCallback(
+    (text: string) => {
+      const clean = text.trim().slice(0, 300);
+      if (!clean) return;
+      const now = Date.now();
+      const last = lastSentRef.current;
+      if (clean === last.text && now - last.at < 4000) return; // recognition repeats itself
+      if (now - last.at < 600) return; // throttle bursts
+      lastSentRef.current = { text: clean, at: now };
+      void send({ type: "caption", text: clean, lang: SPEECH_LANG[locale] });
+    },
+    [send, locale],
+  );
+
+  const stop = useCallback(() => {
+    wantRef.current = false;
+    setListening(false);
+    recRef.current?.stop();
+    recRef.current = null;
+  }, []);
+
+  const start = useCallback(() => {
+    const Ctor =
+      ((window as unknown as { SpeechRecognition?: new () => SpeechRecognitionLike })
+        .SpeechRecognition ??
+      (window as unknown as { webkitSpeechRecognition?: new () => SpeechRecognitionLike })
+        .webkitSpeechRecognition);
+    if (!Ctor) {
+      setNotice(t("cap.unsupported"));
+      return;
+    }
+    setNotice("");
+    const rec = new Ctor();
+    rec.lang = SPEECH_LANG[locale];
+    rec.continuous = true;
+    rec.interimResults = false;
+
+    rec.onresult = (e) => {
+      for (let i = e.resultIndex; i < e.results.length; i++) {
+        const r = e.results[i];
+        if (r?.isFinal) pushCaption(r[0]?.transcript ?? "");
+      }
+    };
+    // Chrome ends the session after silence — quietly restart while enabled.
+    rec.onend = () => {
+      if (wantRef.current) {
+        try {
+          rec.start();
+        } catch {
+          /* already started */
+        }
+      }
+    };
+    rec.onerror = (e) => {
+      if (e.error === "not-allowed" || e.error === "service-not-allowed") {
+        setNotice(t("cap.denied"));
+        wantRef.current = false;
+        setListening(false);
+      }
+    };
+
+    recRef.current = rec;
+    wantRef.current = true;
+    setListening(true);
+    try {
+      rec.start();
+    } catch {
+      /* start called twice */
+    }
+  }, [locale, pushCaption, t]);
+
+  useEffect(() => () => stop(), [stop]);
+
+  // Translate new lines from other people into my interface language.
+  useEffect(() => {
+    for (const c of captions) {
+      if (c.uid === meUid || requestedRef.current.has(c.id)) continue;
+      const spoken = (c.lang.split("-")[0] || "").toLowerCase();
+      if (spoken === locale) continue; // already my language
+      requestedRef.current.add(c.id);
+      void (async () => {
+        try {
+          const res = await fetch("/api/translate", {
+            method: "POST",
+            headers: { "Content-Type": "application/json" },
+            body: JSON.stringify({ text: c.text, to: locale, from: spoken || "auto" }),
+          });
+          const data = (await res.json().catch(() => ({}))) as {
+            ok?: boolean;
+            translated?: string;
+          };
+          if (data.ok && data.translated) {
+            setTranslated((prev) => ({ ...prev, [c.id]: data.translated! }));
+          }
+        } catch {
+          /* offline / rate limited: the original text stays visible */
+        }
+      })();
+    }
+  }, [captions, locale, meUid]);
+
+  // Keep the newest line in view.
+  useEffect(() => {
+    listRef.current?.scrollTo({ top: listRef.current.scrollHeight });
+  }, [captions.length, translated]);
+
+  return (
+    <Card>
+      <CardBody className="space-y-3">
+        <h3 className="flex items-center gap-2 text-sm font-semibold">
+          <Languages className="h-4 w-4" aria-hidden="true" />
+          {t("cap.title")}
+        </h3>
+        <p className="text-xs text-cova-mute">{t("cap.hint")}</p>
+
+        <Button
+          size="sm"
+          variant={listening ? "danger" : "secondary"}
+          className="w-full"
+          disabled={!supported}
+          onClick={() => (listening ? stop() : start())}
+        >
+          {listening ? (
+            <MicOff className="h-4 w-4" aria-hidden="true" />
+          ) : (
+            <Mic className="h-4 w-4" aria-hidden="true" />
+          )}
+          {listening ? t("cap.stop") : t("cap.start")}
+        </Button>
+
+        {notice && (
+          <p className="rounded-lg bg-cova-pale px-3 py-2 text-xs" role="status">
+            {notice}
+          </p>
+        )}
+
+        <div
+          ref={listRef}
+          className="max-h-56 space-y-2.5 overflow-y-auto"
+          aria-live="polite"
+          aria-label={t("cap.title")}
+        >
+          {captions.length === 0 ? (
+            <p className="py-2 text-center text-xs text-cova-mute">{t("cap.empty")}</p>
+          ) : (
+            captions.map((c) => {
+              const mine = c.uid === meUid;
+              const trans = mine ? undefined : translated[c.id];
+              const spokenDir = isRtlLang(c.lang) ? "rtl" : "ltr";
+              return (
+                <div key={c.id} className="rounded-lg bg-cova-bg px-2.5 py-2">
+                  <p className="flex items-center gap-1.5 text-[11px] text-cova-mute">
+                    <span className="truncate font-medium">
+                      {mine ? t("cap.you") : c.name}
+                    </span>
+                    <span className="shrink-0 rounded bg-cova-pale px-1 font-mono text-[10px]">
+                      {shortLang(c.lang)}
+                    </span>
+                  </p>
+                  {trans !== undefined && (
+                    <p className="mt-0.5 text-sm font-medium" dir={LOCALE_DIR[locale]}>
+                      {trans}
+                    </p>
+                  )}
+                  {trans === undefined && !mine && (
+                    <p className="mt-0.5 text-sm" dir={spokenDir}>
+                      {c.text}
+                    </p>
+                  )}
+                  {mine && <p className="mt-0.5 text-sm" dir={spokenDir}>{c.text}</p>}
+                  {trans !== undefined && (
+                    <p className="mt-0.5 text-[11px] text-cova-mute" dir={spokenDir}>
+                      {c.text}
+                    </p>
+                  )}
+                </div>
+              );
+            })
+          )}
+        </div>
+      </CardBody>
+    </Card>
+  );
+}
