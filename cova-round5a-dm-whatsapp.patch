diff --git a/src/components/messages/ChatClient.tsx b/src/components/messages/ChatClient.tsx
new file mode 100644
index 0000000..f3a380f
--- /dev/null
+++ b/src/components/messages/ChatClient.tsx
@@ -0,0 +1,357 @@
+"use client";
+
+import Link from "next/link";
+import { useRouter } from "next/navigation";
+import { useCallback, useEffect, useRef, useState, type FormEvent } from "react";
+import { ArrowLeft, MessageSquare, Send, UserPlus } from "lucide-react";
+import { MediaComposer } from "@/components/common/MediaComposer";
+import { PostAttachments } from "@/components/common/PostAttachments";
+import { Avatar } from "@/components/ui/Avatar";
+import { Badge } from "@/components/ui/Badge";
+import { Button } from "@/components/ui/Button";
+import { EmptyState } from "@/components/ui/EmptyState";
+import { Skeleton } from "@/components/ui/Skeleton";
+import { useToast } from "@/components/ui/Toast";
+import { useT } from "@/i18n/client";
+import { LIMITS, formatWhen, socialActions, useMe } from "@/lib/social-store";
+import { getSupabase } from "@/lib/supabase/client";
+import { useHydrated } from "@/lib/use-hydrated";
+import { cn } from "@/lib/utils";
+import type { PostAttachment } from "@/types/social";
+
+/**
+ * WhatsApp-style 1:1 chat for /messages/[id]. Self-contained: resolves the
+ * peer profile by COVA id, loads the direct_messages thread, keeps it live via
+ * postgres_changes, and sends text plus media attachments (image, camera,
+ * video, voice note, any file) through MediaComposer. Attachments ride in the
+ * direct_messages.attachments jsonb column (20261102000005_dm_rich_media.sql);
+ * if that column is not migrated yet, a text message still goes through.
+ */
+
+interface Peer {
+  uuid: string;
+  code: string;
+  name: string;
+  tone: "pale" | "soft" | "muted";
+  avatarUrl: string | null;
+  headline: string | null;
+}
+
+interface DmMessage {
+  id: string;
+  from_id: string;
+  body: string | null;
+  attachments: PostAttachment[];
+  created_at: string;
+}
+
+type Relation = "none" | "sent" | "received" | "friends";
+
+const PROFILE_COLUMNS = "id,display_name,tone,avatar_url,headline";
+
+/** Thread filter: every row between me and the peer, in both directions. */
+function threadFilter(meUuid: string, peerUuid: string): string {
+  return `and(from_id.eq.${meUuid},to_id.eq.${peerUuid}),and(from_id.eq.${peerUuid},to_id.eq.${meUuid})`;
+}
+
+export function ChatClient({ peerCode }: { peerCode: string }) {
+  const toast = useToast();
+  const t = useT();
+  const router = useRouter();
+  const hydrated = useHydrated();
+  const me = useMe();
+  const meId = me?.id ?? "";
+
+  const [meUuid, setMeUuid] = useState("");
+  const [peer, setPeer] = useState<Peer | null>(null);
+  const [failed, setFailed] = useState(false);
+  const [messages, setMessages] = useState<DmMessage[]>([]);
+  const [relation, setRelation] = useState<Relation>("none");
+  const [draft, setDraft] = useState("");
+  const [attachments, setAttachments] = useState<PostAttachment[]>([]);
+  const [composerEpoch, setComposerEpoch] = useState(0);
+  const [sending, setSending] = useState(false);
+  const endRef = useRef<HTMLDivElement>(null);
+
+  const peerUuid = peer?.uuid ?? "";
+  const firstName = peer?.name.split(" ")[0] ?? "";
+  const msgCount = messages.length;
+
+  // My auth uuid — needed for uuid-level thread queries.
+  useEffect(() => {
+    let alive = true;
+    void (async () => {
+      const { data } = await getSupabase().auth.getUser();
+      if (alive) setMeUuid(data.user?.id ?? "");
+    })();
+    return () => {
+      alive = false;
+    };
+  }, []);
+
+  // Resolve the peer profile by COVA id. The live database exposes user_code;
+  // older setups used public_id, so fall back to it when the first lookup
+  // errors or misses.
+  useEffect(() => {
+    let alive = true;
+    const frame = requestAnimationFrame(() => {
+      void (async () => {
+        const sb = getSupabase();
+        let row: Record<string, unknown> | null = null;
+        const first = await sb.from("profiles").select(PROFILE_COLUMNS).eq("user_code", peerCode).maybeSingle();
+        row = first.data;
+        if (first.error || !row) {
+          const second = await sb.from("profiles").select(PROFILE_COLUMNS).eq("public_id", peerCode).maybeSingle();
+          row = second.data;
+        }
+        if (!alive) return;
+        if (!row) {
+          setFailed(true);
+          return;
+        }
+        setPeer({
+          uuid: String(row.id),
+          code: peerCode,
+          name: String(row.display_name ?? "Unknown"),
+          tone: (row.tone as Peer["tone"]) ?? "soft",
+          avatarUrl: (row.avatar_url as string | null) ?? null,
+          headline: (row.headline as string | null) ?? null,
+        });
+      })();
+    });
+    return () => {
+      alive = false;
+      cancelAnimationFrame(frame);
+    };
+  }, [peerCode]);
+
+  // Load the whole thread (both directions), newest last.
+  const load = useCallback(async () => {
+    if (!meUuid || !peerUuid) return;
+    const { data, error } = await getSupabase()
+      .from("direct_messages")
+      .select("*")
+      .or(threadFilter(meUuid, peerUuid))
+      .order("created_at", { ascending: true })
+      .limit(500);
+    if (error) return;
+    setMessages(
+      ((data ?? []) as Array<Record<string, unknown>>).map((r) => ({
+        id: String(r.id),
+        from_id: String(r.from_id),
+        body: (r.body as string | null) ?? null,
+        attachments: Array.isArray(r.attachments) ? (r.attachments as PostAttachment[]) : [],
+        created_at: String(r.created_at),
+      })),
+    );
+  }, [meUuid, peerUuid]);
+
+  useEffect(() => {
+    const frame = requestAnimationFrame(() => {
+      void load();
+    });
+    return () => cancelAnimationFrame(frame);
+  }, [load]);
+
+  // Live updates: any insert/update touching my side of the conversation.
+  useEffect(() => {
+    if (!meUuid || !peerUuid) return;
+    const sb = getSupabase();
+    const channel = sb
+      .channel(`dm-thread-${meUuid.slice(0, 8)}-${peerUuid.slice(0, 8)}`)
+      .on(
+        "postgres_changes",
+        { event: "*", schema: "public", table: "direct_messages", filter: `from_id=eq.${meUuid}` },
+        () => void load(),
+      )
+      .on(
+        "postgres_changes",
+        { event: "*", schema: "public", table: "direct_messages", filter: `to_id=eq.${meUuid}` },
+        () => void load(),
+      )
+      .subscribe();
+    return () => {
+      void sb.removeChannel(channel);
+    };
+  }, [meUuid, peerUuid, load]);
+
+  // Read receipts: tell the server I have seen the thread up to now.
+  useEffect(() => {
+    if (!meUuid || !peerUuid) return;
+    void getSupabase().rpc("mark_thread_read", { p_other: peerUuid });
+  }, [meUuid, peerUuid, msgCount]);
+
+  // Friendship status drives the header action (add / accept / badge).
+  useEffect(() => {
+    if (!meUuid || !peerUuid) return;
+    void (async () => {
+      const { data } = await getSupabase()
+        .from("friendships")
+        .select("from_id,status")
+        .or(threadFilter(meUuid, peerUuid))
+        .limit(1);
+      const row = (data ?? [])[0] as { from_id: string; status: string } | undefined;
+      if (!row) {
+        setRelation("none");
+      } else if (row.status === "accepted") {
+        setRelation("friends");
+      } else if (row.status === "pending") {
+        setRelation(row.from_id === meUuid ? "sent" : "received");
+      } else {
+        setRelation("none");
+      }
+    })();
+  }, [meUuid, peerUuid]);
+
+  const lastAt = messages[msgCount - 1]?.created_at ?? "";
+  useEffect(() => {
+    endRef.current?.scrollIntoView({ block: "end" });
+  }, [peerUuid, lastAt, msgCount]);
+
+  async function send(e: FormEvent) {
+    e.preventDefault();
+    if (!peer || sending) return;
+    const body = draft.trim();
+    if (!body && attachments.length === 0) return;
+    setSending(true);
+
+    const sb = getSupabase();
+    const payload: Record<string, unknown> = { to_id: peer.uuid, body: body || null };
+    if (attachments.length > 0) payload.attachments = attachments;
+
+    let error: { message: string } | null = null;
+    const first = await sb.from("direct_messages").insert(payload);
+    error = first.error;
+    if (error && attachments.length > 0) {
+      // attachments column not migrated yet — still deliver the text.
+      const second = await sb.from("direct_messages").insert({ to_id: peer.uuid, body });
+      if (!second.error) toast.push(t("chat.mediaNeedsSetup"));
+      error = second.error;
+    }
+
+    setSending(false);
+    if (error) {
+      toast.push(error.message);
+      return;
+    }
+    setDraft("");
+    setAttachments([]);
+    setComposerEpoch((n) => n + 1); // remount MediaComposer empty
+    void load();
+  }
+
+  async function addFriend() {
+    if (!meId || !peer) return;
+    const result = await socialActions.sendFriendRequest(meId, peer.code);
+    toast.push(result.ok ? `${t("messages.requestSent")} ${firstName}` : result.error);
+    if (result.ok) setRelation("sent");
+  }
+
+  async function acceptRequest() {
+    if (!meId || !peer) return;
+    const result = await socialActions.respondFriendRequest(meId, peer.code, true);
+    toast.push(result.ok ? `${t("messages.youAreNowFriends")} ${firstName}` : result.error);
+    if (result.ok) setRelation("friends");
+  }
+
+  if (!hydrated) return <Skeleton className="h-96 w-full" />;
+
+  if (!me) {
+    return (
+      <EmptyState icon={MessageSquare} title={t("chat.signin")} description={""} />
+    );
+  }
+
+  if (failed) {
+    return (
+      <EmptyState
+        icon={MessageSquare}
+        title={t("chat.peerNotFound")}
+        description={peerCode}
+      />
+    );
+  }
+
+  if (!peer) return <Skeleton className="h-96 w-full" />;
+
+  return (
+    <div className="flex h-[calc(100vh-17rem)] min-h-[28rem] flex-col overflow-hidden rounded-xl border border-cova-line bg-white">
+      <div className="flex items-center gap-3 border-b border-cova-line px-4 py-3">
+        <button
+          type="button"
+          onClick={() => router.push("/messages")}
+          aria-label={t("messages.backToConversations")}
+          className="rounded-lg p-1.5 hover:bg-cova-pale"
+        >
+          <ArrowLeft className="h-5 w-5 rtl:-scale-x-100" aria-hidden="true" />
+        </button>
+        <Avatar name={peer.name} src={peer.avatarUrl ?? undefined} tone={peer.tone} size="sm" />
+        <div className="min-w-0 flex-1">
+          <p className="font-semibold">
+            <Link href={`/community/${peer.code}`} className="truncate hover:underline">
+              {peer.name}
+            </Link>
+          </p>
+          <p className="truncate text-xs text-cova-mute">{peer.headline || peer.code}</p>
+        </div>
+        {relation === "none" && (
+          <Button size="sm" variant="secondary" onClick={addFriend}>
+            <UserPlus className="h-4 w-4" aria-hidden="true" /> {t("messages.addFriend")}
+          </Button>
+        )}
+        {relation === "sent" && <Badge tone="outline">{t("messages.requestSent")}</Badge>}
+        {relation === "received" && (
+          <Button size="sm" onClick={acceptRequest}>
+            {t("messages.acceptRequest")}
+          </Button>
+        )}
+        {relation === "friends" && <Badge tone="soft">{t("messages.friends")}</Badge>}
+      </div>
+
+      <div className="flex-1 space-y-3 overflow-y-auto bg-cova-bg p-4">
+        {messages.length === 0 && (
+          <p className="text-center text-sm text-cova-mute">
+            {t("messages.noMessagesYet")} {firstName}.
+          </p>
+        )}
+        {messages.map((m) => {
+          const mine = m.from_id === meUuid;
+          return (
+            <div key={m.id} className={cn("flex", mine ? "justify-end" : "justify-start")}>
+              <div
+                className={cn(
+                  "max-w-[80%] rounded-2xl px-4 py-2 text-sm",
+                  mine ? "bg-cova-soft" : "border border-cova-line bg-white",
+                )}
+              >
+                {m.attachments.length > 0 && <PostAttachments attachments={m.attachments} />}
+                {m.body && <p className="whitespace-pre-line break-words">{m.body}</p>}
+                <p className="mt-1 text-[11px] text-cova-ink/70">
+                  {formatWhen(new Date(m.created_at).getTime())}
+                </p>
+              </div>
+            </div>
+          );
+        })}
+        <div ref={endRef} />
+      </div>
+
+      <form onSubmit={send} className="space-y-2 border-t border-cova-line p-3">
+        <MediaComposer key={composerEpoch} spaceId="dm" onChange={setAttachments} />
+        <div className="flex gap-2">
+          <input
+            aria-label={t("messages.message")}
+            value={draft}
+            maxLength={LIMITS.text.max}
+            onChange={(e) => setDraft(e.target.value)}
+            placeholder={`${t("messages.message")} ${firstName}`}
+            className="h-10 flex-1 rounded-lg border border-cova-line px-3 text-sm placeholder:text-cova-mute"
+          />
+          <Button type="submit" disabled={sending || (!draft.trim() && attachments.length === 0)}>
+            <Send className="h-4 w-4 rtl:-scale-x-100" aria-hidden="true" /> {t("messages.send")}
+          </Button>
+        </div>
+      </form>
+    </div>
+  );
+}
